# ============================================
# Configuración del Agente de Contenido IA
# ============================================
# Copia este archivo como .env y rellena tus valores:
#   cp .env.example .env

# Tu API Key de Anthropic (obligatorio)
# Obtenerla en: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-tu-api-key-aqui

# Puerto del servidor (Cloud Run lo setea automáticamente)
PORT=3001

# Nombre de tu tienda (se usa en los prompts)
STORE_NAME=Mi Tienda

# Descripción breve de tu tienda (ayuda a la IA a entender tu marca)
STORE_DESCRIPTION=Tienda online de productos premium

# Tono por defecto de tu marca
DEFAULT_TONE=profesional

# ── Canva Integration (opcional) ─────────────────────────────────────────
# Obtener en: https://www.canva.com/developers/apps
# 1. Crear una app en el portal de developers de Canva
# 2. Activar: "Design creation", "Read designs", "Brand Templates"
# 3. Agregar OAuth Redirect URI: https://TU_DOMINIO/auth/canva/callback
CANVA_CLIENT_ID=tu-canva-client-id
CANVA_CLIENT_SECRET=tu-canva-client-secret
CANVA_REDIRECT_URI=https://jarvis-7mu74jneba-uc.a.run.app/auth/canva/callback
